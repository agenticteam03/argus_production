        "operationId": "target_metrics_route_api_v1_target_metrics_get",
        "parameters": [
          {
            "in": "query",
            "name": "target",
            "required": true,
            "schema": {
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.-]+/[a-z_]+:[A-Za-z0-9_.-]+$",
              "title": "Target",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "range",
            "required": false,
            "schema": {
