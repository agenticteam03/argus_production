# Example environment for the frontend. Copy to `.env.local` (gitignored) and adjust.
#
# Mock adapters are the default, so the offline demo and `npm test` need no server.
# Set this to 0 to talk to the real API through the dev proxy in vite.config.js:
#   ssh -L 18000:127.0.0.1:18000 argus-vm095
VITE_ARGUS_MOCK=1

# Optional (mock mode): replace the 3 demo logins with your own — no database, no server. A JSON map of
# username -> { password, role }, where role is viewer | operator | approver. Unset, or a typo, falls back
# to the demo accounts viewer / operator / approver (password `argus-demo`).
# VITE_ARGUS_USERS={"ana":{"password":"change-me","role":"operator"},"sam":{"password":"change-me","role":"viewer"},"gil":{"password":"change-me","role":"approver"}}

# Optional (mock mode): how long a session survives before it expires, in minutes (default 480 = 8 h).
# A reload inside this window keeps you logged in; logging out ends it immediately.
# VITE_ARGUS_SESSION_TTL_MIN=480
