# Raw discovery reports contain IP addresses and container names: summaries go to the Brain.
ops/discovery-*.txt
output*.bash

# Secrets and local environment — never in the repository (SSH keys stay in ~/.ssh on the laptop)
.env
*.env.local
deploy/**/secrets/
*.pem
*.key
*_ed25519
*_rsa

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.db
*.tgz

argus.egg-info/

# VM-local host addresses (template: deploy/hosts.env.example)
hosts.env

# Frontend (Node) — dependencies and build output are never committed
node_modules/
frontend/dist/
