# Copy to /opt/argus-v18/app/deploy/ui/vm-095.env on vm-095 (gitignored): the public name of the UI (ACR-0011).
# Never commit the real domain or address (policies/SECURITY.md rule 4).
ARGUS_UI_DOMAIN=argus.example.org
# ACR-0018 step 4: the private path, /api/v1/ops/ (on needs edge-ops/ca.crt and crl.pem, unless the next one is on).
# ARGUS_OPS_PATH=on
# ACR-0038: on = no client certificate; the private login, two security keys and the step-up are the proof (default off).
# ARGUS_OPS_PASSKEY_ONLY=off
