# Copy to /opt/argus-v18/hosts.env on EACH VM (root 0644) and fill in the real private IPs.
# The real file is never committed. Used by: deploy/vm-095/compose.core.yml (--env-file), ops/*.sh.
ARGUS_VM095_PRIVATE_IP=10.0.0.x
ARGUS_VM166_PRIVATE_IP=10.0.0.y
# vm-095 only (ACR-0018 phase 16 step 3): WebAuthn's relying party and origin, the UI's DNS name (ARGUS_UI_DOMAIN)
ARGUS_WEBAUTHN_RP_ID=argus.example.org
ARGUS_WEBAUTHN_ORIGIN=https://argus.example.org
