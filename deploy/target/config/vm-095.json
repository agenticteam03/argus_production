{
  "host": "vm-095",
  "containers": [
    "argus-lab-worker",
    "argus-lab-api"
  ],
  "dns_names": [
    "argus-lab-worker",
    "argus-lab-api"
  ],
  "tcp": [],
  "http_endpoints": [],
  "http_probes": [],
  "probes": [],
  "mounts": [
    "/"
  ],
  "databases": [],
  "inspection": {
    "targets": {
      "vm-095/host:vm-095": {
        "files": [],
        "service_config": [],
        "processes": true,
        "journal": {
          "units": [
            "docker.service",
            "containerd.service"
          ],
          "max_lines": 200
        }
      }
    },
    "deny": [
      "environment_variables",
      "/run/secrets/",
      "/opt/argus-v18/secrets/",
      "/root/",
      "/proc/",
      "/var/lib/docker/",
      "/etc/shadow",
      "/etc/shadow-",
      "/etc/gshadow",
      "/etc/gshadow-",
      "/etc/sudoers",
      "/etc/sudoers.d/",
      ".ssh",
      "id_*",
      "*.key",
      "*.pem",
      ".env",
      "*.env",
      "*password*",
      "*token*"
    ],
    "limits": {
      "max_lines": 500,
      "max_bytes": 65536
    },
    "arbitrary_exec": false
  }
}
