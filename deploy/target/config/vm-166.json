{
  "host": "vm-166",
  "containers": [
    "argus-lab-worker",
    "argus-lab-jobworker",
    "argus-lab-nginx",
    "argus-lab-slow",
    "argus-lab-burner",
    "argus-lab-filler",
    "argus-lab-api",
    "argus-lab-cache",
    "argus-lab-client",
    "argus-lab-backend",
    "argus-lab-db",
    "argus-lab-leaker"
  ],
  "dns_names": [
    "argus-lab-worker",
    "argus-lab-jobworker",
    "argus-lab-nginx",
    "argus-lab-slow",
    "argus-lab-burner",
    "argus-lab-filler",
    "argus-lab-api",
    "argus-lab-cache",
    "argus-lab-client",
    "argus-lab-backend",
    "argus-lab-db",
    "argus-lab-leaker"
  ],
  "tcp": [
    [
      "argus-lab-slow",
      8080
    ],
    [
      "argus-lab-api",
      8080
    ],
    [
      "argus-lab-cache",
      6379
    ],
    [
      "argus-lab-backend",
      8080
    ],
    [
      "argus-lab-db",
      5432
    ]
  ],
  "http_endpoints": [
    "http://argus-lab-nginx:8080/",
    "http://argus-lab-api:8080/health"
  ],
  "http_probes": [
    {
      "owner": "argus-lab-nginx",
      "url": "http://argus-lab-nginx:8080/"
    },
    {
      "owner": "argus-lab-api",
      "url": "http://argus-lab-api:8080/health"
    }
  ],
  "probes": [
    {
      "owner": "argus-lab-jobworker",
      "dependency": "argus-lab-cache",
      "host": "argus-lab-cache",
      "port": 6379,
      "protocol": "redis"
    },
    {
      "owner": "argus-lab-nginx",
      "dependency": "argus-lab-slow",
      "host": "argus-lab-slow",
      "port": 8080
    },
    {
      "owner": "argus-lab-api",
      "dependency": "argus-lab-cache",
      "host": "argus-lab-cache",
      "port": 6379,
      "protocol": "redis"
    },
    {
      "owner": "argus-lab-client",
      "dependency": "argus-lab-backend",
      "host": "argus-lab-backend",
      "port": 8080
    },
    {
      "owner": "argus-lab-client",
      "dependency": "argus-lab-api",
      "host": "argus-lab-api",
      "port": 8080
    },
    {
      "owner": "argus-lab-leaker",
      "dependency": "argus-lab-db",
      "host": "argus-lab-db",
      "port": 5432
    }
  ],
  "mounts": [
    "/",
    "/srv/argus-lab-fill"
  ],
  "databases": [
    {
      "name": "argus-lab-db",
      "host": "argus-lab-db",
      "port": 5432,
      "dbname": "argus_lab"
    }
  ],
  "inspection": {
    "targets": {
      "vm-166/container:argus-lab-nginx": {
        "files": [],
        "service_config": [
          "/opt/argus-v18/app/deploy/lab/nginx/default.conf"
        ],
        "processes": false
      },
      "vm-166/host:vm-166": {
        "files": [],
        "service_config": [],
        "processes": true,
        "journal": {
          "units": [
            "docker.service",
            "containerd.service"
          ],
          "max_lines": 200
        }
      }
    },
    "deny": [
      "environment_variables",
      "/run/secrets/",
      "/opt/argus-v18/secrets/",
      "/root/",
      "/proc/",
      "/var/lib/docker/",
      "/etc/shadow",
      "/etc/shadow-",
      "/etc/gshadow",
      "/etc/gshadow-",
      "/etc/sudoers",
      "/etc/sudoers.d/",
      ".ssh",
      "id_*",
      "*.key",
      "*.pem",
      ".env",
      "*.env",
      "*password*",
      "*token*"
    ],
    "limits": {
      "max_lines": 500,
      "max_bytes": 65536
    },
    "arbitrary_exec": false
  }
}
