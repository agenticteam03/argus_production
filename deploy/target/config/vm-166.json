{
  "host": "vm-166",
  "containers": [
    "argus-lab-worker",
    "argus-lab-api",
    "argus-lab-cache",
    "argus-lab-client",
    "argus-lab-backend",
    "argus-lab-db",
    "argus-lab-leaker"
  ],
  "dns_names": [
    "argus-lab-worker",
    "argus-lab-api",
    "argus-lab-cache",
    "argus-lab-client",
    "argus-lab-backend",
    "argus-lab-db",
    "argus-lab-leaker"
  ],
  "tcp": [
    [
      "argus-lab-cache",
      6379
    ],
    [
      "argus-lab-backend",
      8080
    ],
    [
      "argus-lab-db",
      5432
    ]
  ],
  "http_endpoints": [
    "http://argus-lab-api:8080/health"
  ],
  "probes": [
    {
      "owner": "argus-lab-api",
      "dependency": "argus-lab-cache",
      "host": "argus-lab-cache",
      "port": 6379
    },
    {
      "owner": "argus-lab-client",
      "dependency": "argus-lab-backend",
      "host": "argus-lab-backend",
      "port": 8080
    },
    {
      "owner": "argus-lab-leaker",
      "dependency": "argus-lab-db",
      "host": "argus-lab-db",
      "port": 5432
    }
  ],
  "mounts": [
    "/",
    "/srv/argus-lab-fill"
  ],
  "databases": [
    {
      "name": "argus-lab-db",
      "host": "argus-lab-db",
      "port": 5432,
      "dbname": "argus_lab"
    }
  ]
}
